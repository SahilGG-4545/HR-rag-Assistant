# ==============================================================================
# HR-RAG Assistant - Environment Configuration Template
# Duplicate this file as .env and fill in your respective API keys.
# ==============================================================================

# LLM & Gateway
PORTKEY_API_KEY="your_portkey_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# Embeddings
JINA_API_KEY="your_jina_api_key_here"

# Vector Database (Qdrant Cloud)
QDRANT_URL="https://your-cluster-id.region.qdrant.tech:6333"
QDRANT_API_KEY="your_qdrant_api_key_here"
QDRANT_COLLECTION_NAME="hr_policy"

# Observability (LangSmith - Optional)
LANGSMITH_TRACING="false"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
LANGSMITH_PROJECT="hr-rag-assistant"
